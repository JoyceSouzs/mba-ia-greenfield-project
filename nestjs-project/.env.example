# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object Storage (MinIO — S3-compatible, Phase 03)
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=streamtube
MINIO_SECRET_KEY=streamtube-secret
BUCKET_VIDEOS_RAW=videos-raw
BUCKET_VIDEOS_PROCESSED=videos-processed
BUCKET_THUMBNAILS=thumbnails
PRESIGN_STREAM_TTL_SECONDS=900
PRESIGN_DOWNLOAD_TTL_SECONDS=3600

# Queue (Redis / BullMQ — Phase 03)
REDIS_HOST=redis
REDIS_PORT=6379
VIDEO_PROCESSING_QUEUE=video-processing
VIDEO_PROCESSING_ATTEMPTS=3
VIDEO_PROCESSING_BACKOFF_MS=10000
